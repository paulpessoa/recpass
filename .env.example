# Gemini (https://aistudio.google.com/apikey). Sem chave, o agente roda no modo regras.
GEMINI_API_KEY=
# Opcional: gemini-3.5-flash-lite (padrão, mais barato) ou gemini-3.8-flash (mais capaz)
GEMINI_MODEL=
# Supabase (somente servidor). Sem estas variáveis, o estado fica em memória.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
