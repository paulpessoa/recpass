# IA do agente: com OPENAI_API_KEY usa a OpenAI; senão GEMINI_API_KEY; sem nenhuma, modo regras (grátis).
OPENAI_API_KEY=
# Opcional: gpt-4.1-mini (padrão) ou gpt-4.1-nano (mais barato e rápido, menos preciso)
OPENAI_MODEL=
GEMINI_API_KEY=
# Opcional: gemini-3.5-flash-lite (padrão)
GEMINI_MODEL=
# Supabase (somente servidor). Sem estas variáveis, o estado fica em memória.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
